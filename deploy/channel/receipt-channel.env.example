# Copy to ~/.config/receipt-channel.env (not committed).
# Telegram API id/hash usually live in ~/.config/telegram-mcp.env

# Required:
TELEGRAM_ACCOUNT_ID=
RECEIPT_CHANNEL=

# Session (absolute path to mcp-telegram StoreSession dir):
# TELEGRAM_SESSION_NAME=/home/YOU/.telegram-agent/sessions/ACCOUNT_ID
# TELEGRAM_SESSION_CWD=/home/YOU/projects/receipt

# cursor-agent (preferred, same host login as interactive Cursor):
# RECEIPT_USE_CURSOR_AGENT=1
# CURSOR_AGENT_BIN=/home/YOU/.local/bin/cursor-agent
# RECEIPT_CURSOR_MODEL=
# RECEIPT_CURSOR_TIMEOUT_MS=240000
# RECEIPT_CURSOR_WORKSPACE=/home/YOU/projects/receipt

# Optional LLM fallback if cursor-agent fails:
# OPENROUTER_API_KEY=
# GROQ_API_KEY=
# OPENAI_API_KEY=
# RECEIPT_LLM_MODEL=

# Owner DM on failures / --preview (default: Saved Messages):
# RECEIPT_OWNER_PEER=me

# Local recipe archive (SQLite). New finds are saved; on failure a random one is posted.
# RECEIPT_DB=/var/lib/receipt/recipes.db
